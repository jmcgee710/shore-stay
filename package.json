{
  "name": "shore-stay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace frontend run dev\" \"npm run dev:api\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:api": "tsx watch api/_lib/index.ts",
    "build": "prisma generate && npm --workspace frontend run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "lint": "npm --workspace frontend run lint"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.19",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.0",
    "prisma": "^5.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
